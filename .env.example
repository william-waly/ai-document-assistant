# Kopier til .env og endre verdiene. .env skal ALDRI committes.

# --- PostgreSQL ---
POSTGRES_USER=docai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docai

# --- Backend ---
# Host "postgres" = service-navnet i docker-compose
DATABASE_URL=postgresql+psycopg://docai:change-me@postgres:5432/docai
CORS_ORIGINS=http://localhost:5173

# Minst 32 tegn. Generer med: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limiting på /auth/*
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=5/minute

# Dokumentopplasting
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=500
UPLOAD_RATE_LIMIT=10/minute

# Chunking og embeddings (lokal Ollama som standard)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Ollama installert på Windows/Mac-maskinen din, sett fra Docker:
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Bruker du Ollama-containeren (--profile local-llm): http://ollama:11434

# LLM for svar. ollama = lokalt, dokumentutdrag forlater aldri maskinen din.
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
LLM_RATE_LIMIT=10/minute
# Under denne likhetsscoren svarer vi "ikke nok informasjon" uten å spørre LLM
RAG_MIN_SCORE=0.60
RAG_TOP_K=5
# Ekstern LLM sender dokumentutdrag til tredjepart. Av som standard.
# For å bruke: LLM_PROVIDER=openai_compatible, ALLOW_EXTERNAL_LLM=true,
# LLM_BASE_URL=https://... og LLM_API_KEY=...
ALLOW_EXTERNAL_LLM=false

# Retention: automatisk sletting etter N dager. 0 = slå av.
DOCUMENT_RETENTION_DAYS=90
CONVERSATION_RETENTION_DAYS=90
# Hvor ofte bakgrunnsjobben sjekker (minutter). 0 = ingen bakgrunnsjobb.
RETENTION_SWEEP_MINUTES=60

# --- Frontend ---
VITE_API_URL=http://localhost:8000
