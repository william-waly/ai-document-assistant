# Kopier til .env og endre verdiene. .env skal ALDRI committes.

# --- PostgreSQL ---
POSTGRES_USER=docai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docai

# --- Backend ---
# Host "postgres" = service-navnet i docker-compose
DATABASE_URL=postgresql+psycopg://docai:change-me@postgres:5432/docai
CORS_ORIGINS=http://localhost:5173

# Minst 32 tegn. Generer med: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limiting på /auth/*
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=5/minute

# Dokumentopplasting
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=500
UPLOAD_RATE_LIMIT=10/minute

# Chunking og embeddings (lokal Ollama som standard)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Ollama installert på Windows/Mac-maskinen din, sett fra Docker:
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Bruker du Ollama-containeren (--profile local-llm): http://ollama:11434

# --- Frontend ---
VITE_API_URL=http://localhost:8000
